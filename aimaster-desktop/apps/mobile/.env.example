# Server mastering API. Set to your Render URL.
VITE_MASTERING_API_URL=https://YOUR-RENDER-APP.onrender.com
VITE_MASTERING_API_KEY=

# Build mode:
#   unset / false  → test build: server-settings screen shown (type URL/KEY in-app)
#   true           → release build: settings screen hidden; server comes from the
#                    VITE_MASTERING_API_URL / VITE_MASTERING_API_KEY above only.
VITE_RELEASE_MODE=false
