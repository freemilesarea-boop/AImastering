<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime: allow JIT for V8 (Electron renderer) -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Allow loading unsigned dylibs (needed for native Node modules) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Allow DYLD environment variables (electron shimming) -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- Disable Library Validation so bundled binaries can run -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- File system access: user-selected files for audio open/save -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- Downloads folder access (default output directory) -->
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
</dict>
</plist>
