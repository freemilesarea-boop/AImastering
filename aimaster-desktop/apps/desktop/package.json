  "scripts": {
    "dev": "concurrently --names RENDERER,MAIN --prefix-colors cyan,yellow \"pnpm dev:renderer\" \"pnpm dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "node esbuild.main.cjs --dev && wait-on http://localhost:5173 && electron dist-electron/main/index.js",
    "build": "pnpm build:renderer && pnpm build:main",
    "build:renderer": "vite build",
    "build:main": "node esbuild.main.cjs",
    "prebuild:ffmpeg": "node scripts/prebuild.cjs",
    "dist": "node scripts/prebuild.cjs && pnpm build && electron-builder",
    "dist:mac": "node scripts/prebuild.cjs && pnpm build && electron-builder --mac zip --x64 --arm64 --publish never",
    "dist:win": "node scripts/prebuild.cjs && pnpm build && electron-builder --win portable --x64 --publish never",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "pnpm test:phase-e-ui && pnpm test:phase-e-render && pnpm test:phase-e-paths && pnpm test:loudness && pnpm test:native-dsp && pnpm test:export-config && pnpm test:shortcuts && pnpm test:daw && pnpm test:automation && pnpm test:tempo && pnpm test:advice && pnpm test:user-presets && pnpm test:stream && pnpm test:plugin-ui && pnpm test:plugin-rack && pnpm test:plugin-scan && pnpm test:plugin-host && pnpm test:reverb && pnpm test:daw-engine && pnpm test:midi && pnpm test:midi-input && pnpm test:varia && pnpm test:macro && pnpm test:ableton && pnpm test:spectral && pnpm test:warp && pnpm test:restore && pnpm test:record && pnpm test:fl && pnpm test:intel",
