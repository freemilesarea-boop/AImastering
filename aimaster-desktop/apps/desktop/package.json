{
  "name": "@aimaster/desktop",
  "version": "3.2.0-rc",
  "description": "Louver Mastering AI — local commercial-grade mastering for desktop",
  "author": "Louver",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently --names RENDERER,MAIN --prefix-colors cyan,yellow \"pnpm dev:renderer\" \"pnpm dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "node esbuild.main.cjs --dev && wait-on http://localhost:5173 && electron dist-electron/main/index.js",
    "build": "pnpm build:renderer && pnpm build:main",
    "build:renderer": "vite build",
    "build:main": "node esbuild.main.cjs",
    "prebuild:ffmpeg": "node scripts/prebuild.cjs",
    "dist": "node scripts/prebuild.cjs && pnpm build && electron-builder",
    "dist:mac": "node scripts/prebuild.cjs && pnpm build && electron-builder --mac zip --x64 --arm64 --publish never",
    "dist:win": "node scripts/prebuild.cjs && pnpm build && electron-builder --win portable --x64 --publish never",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist dist-electron out public/bin"
  },
  "dependencies": {
    "@aimaster/audio-engine": "workspace:*",
    "@aimaster/license-core": "workspace:*",
    "@aimaster/shared-types": "workspace:*",
    "electron-store": "^10.0.0",
    "node-machine-id": "^1.1.12",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^1.4.1",
    "ffmpeg-static": "^5.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "esbuild": "^0.21.0",
    "electron": "28.3.3",
    "electron-builder": "24.13.3",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-dropzone": "^14.3.0",
    "recharts": "^2.12.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0",
    "zustand": "^4.5.0"
  }
}
