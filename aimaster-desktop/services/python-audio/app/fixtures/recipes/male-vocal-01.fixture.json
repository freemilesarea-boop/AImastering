        { "kind": "guitar-pluck","phraseHz": [82, 110, 147], "gainDb": -16, "decay": 0.4 },
        { "kind": "soft-snare", "centerHz": 220, "rateHz": 1.0, "gainDb": -16 },
        { "kind": "kick",       "freqHz": 60, "rateHz": 1.0, "decay": 0.3, "gainDb": -14 }
