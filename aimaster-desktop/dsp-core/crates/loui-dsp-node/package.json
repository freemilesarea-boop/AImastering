{
  "name": "@loui/dsp-node",
  "version": "0.1.0",
  "description": "Node.js / Electron native binding for loui-dsp (M2-lite-NEXT)",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "loui-dsp-node",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "aarch64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform",
    "test": "node examples/tick-loop.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}
