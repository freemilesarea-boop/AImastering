; pnpm settings — Louver Mastering AI
;
; Why: Windows + electron-builder + NSIS combo fails with "could not open file"
; when the path to a header file (e.g. allowOnlyOneInstallerInstance.nsh) exceeds
; Windows' 260-char MAX_PATH.  pnpm's default content-addressable store stores
; packages under .pnpm/<name>@<ver>_<peers-hash>/ which produces extremely long
; directory names when transitive peer-deps are involved (e.g.
; app-builder-lib@24.13.3_dmg-builder@24.13.3_electron-builder-squirrel-...).
;
; Fix: hoist all dependencies into a flat node_modules (npm-style) so packaging
; tools see short paths.  This trades a bit of dedup for build reliability.
node-linker=hoisted
shamefully-hoist=true

; Also cap the .pnpm virtual store directory name length so any indirectly
; referenced files there stay under MAX_PATH on Windows.
virtual-store-dir-max-length=80
