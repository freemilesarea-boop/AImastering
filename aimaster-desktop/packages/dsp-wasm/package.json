{
  "name": "@loui/dsp-wasm",
  "version": "0.1.0",
  "description": "WASM build of loui-dsp — generated by wasm-bindgen from dsp-core/crates/loui-dsp-wasm",
  "private": true,
  "type": "module",
  "main": "./pkg/loui_dsp_wasm.js",
  "module": "./pkg/loui_dsp_wasm.js",
  "types": "./pkg/loui_dsp_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/loui_dsp_wasm.d.ts",
      "import": "./pkg/loui_dsp_wasm.js",
      "default": "./pkg/loui_dsp_wasm.js"
    },
    "./pkg/*": "./pkg/*"
  },
  "files": ["pkg/"],
  "scripts": {
    "build": "bash ../../dsp-core/scripts/build-wasm-bindings.sh"
  }
}
