  "overall": {
    "biggestImprovement":  "",
    "biggestRegression":   "",
    "favouriteFeature":    "",
    "missingFeature":      "",
    "freeNotes":           ""
  },

  "attachments": {
    "debugBundles":  [],
    "outputFiles":   [],
    "referenceFiles": []
  }
